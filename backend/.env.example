# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production — PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/tuhin_watch?schema=public"
# Production — MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/tuhin_watch"

# ── Auth ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-32chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
ACCESS_TOKEN_COOKIE=tw_access
REFRESH_TOKEN_COOKIE=tw_refresh
COOKIE_SECURE=false   # set true behind HTTPS
CSRF_COOKIE=tw_csrf

# ── Rate limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15

# ── Payment gateways (sandbox mode when no keys) ───────────────────────
PAYMENT_MODE=sandbox            # sandbox | live
BKASH_MERCHANT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/checkout/success

# ── Couriers (leave blank to run in offline/log mode) ──────────────────
COURIER_MODE=offline            # offline | sandbox | live
PATHAO_API_URL=https://merchant.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_BASE_URL=https://redx.com.bd
REDX_ACCESS_TOKEN=

# ── Email / SMS (blank = console logging in dev) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tuhin Watch House <no-reply@tuhinwatch.com>"
SMS_PROVIDER=log               # log | twilio | other
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=8

# ── SEO ────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
SITE_NAME=Tuhin Watch House